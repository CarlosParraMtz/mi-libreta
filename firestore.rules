rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function businessData(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data;
    }

    function businessMember(businessId) {
      return signedIn() && request.auth.uid in businessData(businessId).memberIds;
    }

    function businessAdmin(businessId) {
      return signedIn() && (
        request.auth.uid == businessData(businessId).ownerId ||
        request.auth.uid in businessData(businessId).adminIds
      );
    }

    function businessHasAccess(businessId) {
      let subscription = businessData(businessId).get('subscription', {});
      let accessOverride = subscription.get('accessOverride', null);
      return accessOverride == 'unlimited' || (
        accessOverride == 'until'
          ? subscription.get('accessUntilMs', 0) > request.time.toMillis()
          : accessOverride != 'suspended' && (
            subscription.get('trialEndsAtMs', 0) > request.time.toMillis() ||
            subscription.get('currentPeriodEndMs', 0) > request.time.toMillis() ||
            (subscription.get('stripeSubscriptionId', '') != '' && subscription.get('status', 'none') in ['active', 'trialing', 'past_due'])
          )
      );
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || platformAdmin());
      allow create: if signedIn() && request.auth.uid == userId && !request.resource.data.keys().hasAny(['platformAdmin', 'businessIds']);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('platformAdmin', false) == resource.data.get('platformAdmin', false)
        && request.resource.data.get('businessIds', []) == resource.data.get('businessIds', [])
        && (!request.resource.data.keys().hasAny(['defaultBusinessId']) || request.resource.data.defaultBusinessId in resource.data.get('businessIds', []));
      allow delete: if platformAdmin();
    }

    match /businesses/{businessId} {
      allow read: if businessMember(businessId) || platformAdmin();
      allow create: if false;
      allow update: if platformAdmin() || (businessAdmin(businessId) && businessHasAccess(businessId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.adminIds == resource.data.adminIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.get('administrators', []) == resource.data.get('administrators', [])
        && request.resource.data.get('subscription', {}) == resource.data.get('subscription', {}));
      // Toda eliminación pasa por la Lambda para cancelar Stripe y limpiar referencias.
      allow delete: if false;
    }

    // Las invitaciones sólo se leen y escriben desde la Lambda con Firebase Admin.
    match /businessInvites/{inviteId} {
      allow read, write: if false;
    }
  }
}
